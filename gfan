#!/bin/bash
# gfan — fan control for Gigabyte G6 KF (Clevo-ODM EC, reverse-engineered 2026-07)
#
# Two modes, chosen by detect_mode (gigactl-cli-lib.sh):
#
#   daemon — the gigactl daemon owns io.github.smairio.gigactl, which makes it the
#     single writer of the EC. gfan becomes an unprivileged D-Bus client of it: no
#     root (polkit lets the console user do this without a password), no ec_probe,
#     and no chance of the two interleaving mailbox sequences. It never touches a
#     register in this mode.
#   direct — explicitly opted-in writes when the daemon is definitely absent,
#     holding the controller lifetime lease and the EC mailbox lock throughout.
#     When it *cannot tell* — no busctl,
#     no answer from the bus — it refuses rather than guessing direct.
#
# Protocol (EC mailbox, ACPI EC ports via ec_probe):
#   set fan N duty D : 0xF9=N  0xFA=D  0xF8=0xC1  (doorbell last)
#   fan N -> auto    : 0xF9=0xFF 0xFA=N 0xF8=0xC1
# Registers: DUT1=0xCE DUT2=0xCF  tach1=0xD0-D1 tach2=0xD2-D3 (16-bit BE period)
#            CPU temp=0x07  GPU temp=0x0A     RPM ~= 2156220 / tach_period
set -euo pipefail

TOOL=gfan
# The shared plumbing (mode detection, D-Bus helpers, the EC lock): next to this
# script in a checkout, in the package's private directory once installed.
_LIB="$(dirname "$(readlink -f "$0")")/gigactl-cli-lib.sh"
[ -r "$_LIB" ] || _LIB=/usr/lib/gigactl/gigactl-cli-lib.sh
[ -r "$_LIB" ] || { echo "$TOOL: cannot find gigactl-cli-lib.sh" >&2; exit 1; }
. "$_LIB"

# Overridable only so cli/ can drive this as an ordinary user in a tmp directory.
EP=${GFAN_EC_PROBE:-/usr/bin/ec_probe}
STATE=${GFAN_STATE:-/run/gfan.mode}

MODEL=$(cat /sys/class/dmi/id/product_name 2>/dev/null || true)
VENDOR=$(cat /sys/class/dmi/id/sys_vendor 2>/dev/null || true)
BIOS=$(cat /sys/class/dmi/id/bios_version 2>/dev/null || true)

model_check() { # gate WRITE commands on supported hardware (reads still need the lease)
  # Mirror the privileged daemon's exact allowlist (daemon/gigactld/platform.py):
  # GIGABYTE G5 GE on BIOS FB06, or GIGABYTE G6 KF (BIOS coverage unrecorded).
  # Similar model names are refused, not warned through: a write guard that
  # only prints a note is not a guard.
  [ "$VENDOR" = "GIGABYTE" ] || \
    die "vendor '$VENDOR' unsupported — writes require a GIGABYTE machine (allowlist: G5 GE BIOS FB06, G6 KF)."
  case "$MODEL" in
    "G5 GE")
      [ "$BIOS" = "FB06" ] || \
        die "G5 GE writes require BIOS FB06 (found '${BIOS:-unreadable}')." ;;
    "G6 KF") ;;
    *) die "model '$MODEL' unsupported for writes — allowlist: GIGABYTE G5 GE (BIOS FB06) or G6 KF. Reads still work." ;;
  esac
}

# --- daemon mode --------------------------------------------------------------

# The Telemetry property is the signal's six numbers, read on demand — a one-shot
# command cannot wait out the daemon's poll interval.
read_telemetry() { # sets T_CPU T_GPU T_RPM1 T_RPM2 T_DUTY1 T_DUTY2
  local out
  out=$(prop Telemetry) || die "could not read telemetry from the daemon"
  read -r _type T_CPU T_GPU T_RPM1 T_RPM2 T_DUTY1 T_DUTY2 <<<"$out"
  [ -n "${T_DUTY2:-}" ] || die "unexpected telemetry from the daemon: $out"
}

daemon_temperatures() { read_telemetry; }

daemon_set_duties() { # $1=fan1 pct $2=fan2 pct
  if [ "$1" -eq "$2" ]; then
    # Selector 0 is both fans in one call: the daemon verifies the pair together
    # and reverts the pair together, so a refusal cannot strand one fan alone in
    # manual mode.
    call SetFanDuty uu 0 "$1"
    return 0
  fi
  call SetFanDuty uu 1 "$1"
  if ! try_call SetFanDuty uu 2 "$2"; then
    local fan2_error=$CALL_ERROR
    # fan1 is already manual at $1% — mirror direct mode's recovery rather
    # than leaving it stranded there.
    if try_call RestoreFirmware; then
      die "the daemon refused fan2's duty: $fan2_error — reverted both fans to firmware auto."
    fi
    die "the daemon refused fan2's duty: $fan2_error — and reverting failed too: $CALL_ERROR"
  fi
  return 0
}

daemon_restore_auto() { call RestoreFirmware; }

daemon_status() {
  local profile
  read_telemetry
  profile=$(prop ActiveProfile) || profile='s "unknown"'
  profile=${profile#s \"}; profile=${profile%\"}
  echo "CPU: ${T_CPU}°C   GPU: ${T_GPU}°C"
  printf "Fan1 (CPU): duty %3d%%  ~%4d RPM\n" "$T_DUTY1" "$T_RPM1"
  printf "Fan2 (GPU): duty %3d%%  ~%4d RPM\n" "$T_DUTY2" "$T_RPM2"
  echo "Mode: gigactl daemon, profile $profile"
  # After the numbers, not before: the profile line is what a user came for, and
  # the warning explains why it is not happening rather than replacing it.
  warn_if_ec_stuck
}

# --- direct mode --------------------------------------------------------------

rd() {
  local out value rc
  out=$("$EP" read "$1" 2>/dev/null) || {
    rc=$?; warn "EC read $1 failed (status $rc)"; return "$rc";
  }
  read -r value _ <<< "$out"
  if [[ "$value" =~ ^[0-9]{1,3}$ ]]; then
    value=$((10#$value))
  elif [[ "$value" =~ ^0[xX][0-9a-fA-F]{1,2}$ ]]; then
    value=$((value))
  else
    warn "invalid EC byte from register $1: $out"; return 1
  fi
  [ "$value" -le 255 ] || { warn "out-of-range EC byte from register $1: $out"; return 1; }
  echo "$value"
}

send() { # send fan-cmd: $1=FDAT $2=FBUF
  # Explicit returns matter when called by recovery inside an if/|| context:
  # Bash disables errexit there, and a failed parameter must not ring a doorbell.
  "$EP" write 0xF9 "$1" >/dev/null || return $?
  "$EP" write 0xFA "$2" >/dev/null || return $?
  "$EP" write 0xF8 0xC1 >/dev/null || return $?
}

set_fan() { # $1=fan index (1|2), $2=percent
  local duty=$(( $2 * 255 / 100 ))
  send "$1" "$duty"
}

auto_fan() { send 0xFF "$1"; }

FAN_TRANSACTION=0

restore_both() {
  local rc1=0 rc2=0
  # Independent attempts: a failed first fan must never skip the second fan.
  auto_fan 1 || rc1=$?
  sleep 0.3 || true
  auto_fan 2 || rc2=$?
  if [ "$rc1" -ne 0 ] || [ "$rc2" -ne 0 ]; then
    warn "firmware-auto command failures: fan1 status $rc1, fan2 status $rc2; recovery is NOT confirmed."
    [ "$rc1" -eq 0 ] || return "$rc1"
    return "$rc2"
  fi
  rm -f "$STATE" || return $?
}

fan_transaction_exit() {
  local rc=$1
  trap - EXIT
  # Finish BOTH attempts even if another INT/TERM arrives during recovery. This
  # is best effort only: SIGKILL, power loss and a dead EC cannot be handled.
  trap '' INT TERM
  if [ "$FAN_TRANSACTION" -eq 1 ] && [ "$rc" -ne 0 ]; then
    warn "fan transaction failed (status $rc); attempting firmware auto for BOTH fans."
    if restore_both; then
      warn "firmware-auto commands sent to both fans; firmware mode is not read-back verified."
    else
      warn "firmware recovery incomplete; fan mode is UNKNOWN."
      echo "unknown: firmware-auto recovery incomplete" > "$STATE" || \
        warn "could not record the unknown fan mode"
    fi
  fi
  exit "$rc"
}

begin_fan_transaction() {
  trap 'fan_transaction_exit $?' EXIT
  trap 'exit 130' INT
  trap 'exit 143' TERM
  FAN_TRANSACTION=1
}

verify_or_revert() { # $1=pct1 $2=pct2 — safety net for unknown models.
  # The EC ramps duty gradually (downward ~11/s), so poll until converged;
  # revert only if duty stops moving while still far from target.
  local d1=$(( $1 * 255 / 100 )) d2=$(( $2 * 255 / 100 ))
  local i g1 g2 e1 e2 last1=-99 last2=-99 strikes=0
  for i in $(seq 1 50); do  # up to ~25s (full-range downward glide)
    sleep 0.5
    guard "$(( $1 < $2 ? $1 : $2 ))"
    g1=$(rd 0xCE) || return $?
    g2=$(rd 0xCF) || return $?
    e1=$(( g1 > d1 ? g1 - d1 : d1 - g1 ))
    e2=$(( g2 > d2 ? g2 - d2 : d2 - g2 ))
    [ "$e1" -le 10 ] && [ "$e2" -le 10 ] && return 0   # converged
    if [ "$i" -ge 3 ]; then
      local m1=$(( g1 > last1 ? g1 - last1 : last1 - g1 ))
      local m2=$(( g2 > last2 ? g2 - last2 : last2 - g2 ))
      if [ "$m1" -le 1 ] && [ "$m2" -le 1 ]; then
        strikes=$(( strikes + 1 ))
        if [ "$strikes" -ge 3 ]; then  # ~1.5s of no movement, off-target
          if [ "$e1" -le 40 ] && [ "$e2" -le 40 ]; then
            echo "gfan: note: EC settled at $(( g1 * 100 / 255 ))%/$(( g2 * 100 / 255 ))% (firmware clamp?)" >&2
            return 0
          fi
          die "EC did not accept the duty write — protocol may not match '$MODEL'."
        fi
      else
        strikes=0
      fi
    fi
    last1=$g1; last2=$g2
  done
  die "duty never converged — protocol may not match '$MODEL'."
}

direct_temperatures() {
  T_CPU=$(rd 0x07) || return $?
  T_GPU=$(rd 0x0A) || return $?
}

rpm_of() { # $1=hi-byte reg, $2=lo-byte reg
  local hi lo raw
  hi=$(rd "$1") || return $?
  lo=$(rd "$2") || return $?
  raw=$(( hi * 256 + lo ))
  if [ "$raw" -eq 0 ] || [ "$raw" -ge 65280 ]; then echo 0; else echo $(( 2156220 / raw )); fi
}

direct_set_duties() { # $1=fan1 pct $2=fan2 pct
  begin_fan_transaction
  set_fan 1 "$1"; sleep 0.3; set_fan 2 "$2"
  verify_or_revert "$1" "$2"
  echo "manual: fan1=${1}% fan2=${2}%" > "$STATE"
  warn "direct manual duty has no ongoing thermal watchdog; use the daemon for sustained control."
}

direct_restore_auto() {
  begin_fan_transaction
  restore_both
}

direct_status() {
  local d1 d2 r1 r2 mode
  d1=$(rd 0xCE) || return $?
  d2=$(rd 0xCF) || return $?
  r1=$(rpm_of 0xD0 0xD1) || return $?
  r2=$(rpm_of 0xD2 0xD3) || return $?
  direct_temperatures
  mode=$(cat "$STATE" 2>/dev/null || echo "unknown (no saved direct-mode state; firmware default expected)")
  echo "CPU: ${T_CPU}°C   GPU: ${T_GPU}°C"
  printf "Fan1 (CPU): duty %3d%%  ~%4d RPM\n" $(( d1 * 100 / 255 )) "$r1"
  printf "Fan2 (GPU): duty %3d%%  ~%4d RPM\n" $(( d2 * 100 / 255 )) "$r2"
  echo "Mode: $mode"
}

# --- shared -------------------------------------------------------------------

watch_loop() {
  trap 'exit 0' INT
  while true; do clear; date '+%H:%M:%S'; op status; sleep 2; done
}

usage() {
  cat <<'EOF'
gfan — fan control for Gigabyte G6 KF

Usage:
  gfan status            show temps, duty, RPM
  gfan watch             live status every 2s (Ctrl-C to quit)
  gfan auto              both fans -> firmware automatic control
  gfan max               both fans -> 100%
  gfan <pct>             both fans -> pct% (0-100)
  gfan <pct1> <pct2>     fan1 (CPU) -> pct1%, fan2 (GPU) -> pct2%
  gfan <pct> --force     obsolete; DOES NOT bypass thermal safety

Notes:
  * With the gigactl daemon running, gfan drives it over D-Bus and needs no root.
    Without it, writes require explicit GIGACTL_ALLOW_DIRECT=1 and root/sudo.
    Direct reads and writes hold an exclusive controller lease; an unknown bus
    state refuses access. A running daemon never permits direct fallback.
  * Settings reset to automatic on reboot (safe default).
  * Conservative SOFTWARE thresholds, not firmware critical limits: at either
    sensor >=70°C require >=30%; CPU >=95°C OR GPU >=87°C require both at 100%.
    This includes the legacy 30% floor at 85°C. --force cannot bypass safety.
  * Direct manual duty has no ongoing watchdog after this command exits.
    Failure/INT/TERM attempt firmware auto for BOTH fans; no SIGKILL guarantee.
EOF
}

is_pct() { [[ "$1" =~ ^[0-9]+$ ]] && [ "$1" -le 100 ]; }

guard() { # $1 = lowest requested pct
  op temperatures
  # Mirror the daemon's thermal policy (daemon/gigactld/safety.py): CPU data is
  # mandatory (1..125°C); a GPU reading of 0 means unavailable/asleep, not
  # 0°C, so it is ignored rather than treated as a fatal sensor failure. A
  # nonzero GPU reading outside 1..125 is invalid data and refuses the write.
  [[ "$T_CPU" =~ ^[0-9]{1,3}$ ]] && [ "$T_CPU" -ge 1 ] && [ "$T_CPU" -le 125 ] || \
    die "cannot establish a safe CPU temperature (CPU=${T_CPU}, GPU=${T_GPU}) — refusing manual duty."
  [[ "$T_GPU" =~ ^[0-9]{1,3}$ ]] && { [ "$T_GPU" -eq 0 ] || { [ "$T_GPU" -ge 1 ] && [ "$T_GPU" -le 125 ]; }; } || \
    die "cannot establish safe temperatures (CPU=${T_CPU}, GPU=${T_GPU}) — refusing manual duty."
  if [ "$1" -lt 100 ] && { [ "$T_CPU" -ge 95 ] || [ "$T_GPU" -ge 87 ]; }; then
    die "refusing ${1}% at CPU=${T_CPU}°C / GPU=${T_GPU}°C: software emergency requires BOTH fans at 100% (CPU>=95°C or GPU>=87°C)."
  fi
  if [ "$1" -lt 30 ] && { [ "$T_CPU" -ge 70 ] || [ "$T_GPU" -ge 70 ]; }; then
    die "refusing ${1}% at CPU=${T_CPU}°C / GPU=${T_GPU}°C: software floor requires >=30% at either sensor >=70°C (including the legacy 85°C floor)."
  fi
}

main() {
  case "${1:-}" in
    -h|--help|help) usage; return 0 ;;
  esac

  detect_mode
  if [ "$MODE" = direct ]; then
    local write=1
    case "${1:-}" in status|watch|"") write=0 ;; esac
    prepare_direct "$write" "$@"
  fi

  case "${1:-}" in
    status|"") op status ;;
    watch) watch_loop ;;
    auto)
      model_check
      op restore_auto
      if [ "$MODE" = daemon ]; then
        echo "Fans restored to firmware automatic control."
      else
        echo "Firmware-auto commands sent to both fans; firmware mode is not read-back verified."
      fi ;;
    max)
      model_check
      guard 100
      op set_duties 100 100
      echo "Both fans at 100%." ;;
    *)
      local args=()
      for a in "$@"; do
        if [ "$a" = "--force" ]; then
          warn "--force is obsolete and cannot bypass thermal safety."
        else
          args+=("$a")
        fi
      done
      local n=${#args[@]}
      { [ "$n" -ge 1 ] && [ "$n" -le 2 ]; } || { usage; exit 1; }
      for p in "${args[@]}"; do is_pct "$p" || die "'$p' is not a percentage 0-100"; done
      local p1=$((10#${args[0]})) p2=$((10#${args[0]}))
      [ "$n" -eq 2 ] && p2=$((10#${args[1]}))
      model_check
      local low=$(( p1 < p2 ? p1 : p2 )); guard "$low"
      op set_duties "$p1" "$p2"
      echo "Set: fan1 (CPU) = ${p1}%, fan2 (GPU) = ${p2}%"
      ;;
  esac
}

main "$@"
